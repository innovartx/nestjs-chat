{
  "name": "nestjs-chat",
  "version": "0.2.0",
  "description": "Production-ready real-time chat SDK for NestJS — ChatModule.forRoot() with Prisma, PostgreSQL, Socket.IO, BullMQ, Redis.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "canisius ADOGNON",
  "homepage": "https://innovartx.github.io/nestjs-chat/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innovartx/nestjs-chat.git"
  },
  "bugs": {
    "url": "https://github.com/innovartx/nestjs-chat/issues"
  },
  "keywords": [
    "nestjs",
    "chat",
    "realtime",
    "socket.io",
    "websocket",
    "messaging",
    "prisma",
    "postgresql",
    "bullmq",
    "redis",
    "multi-tenant",
    "sdk"
  ],
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "bin",
    "prisma/schema.prisma",
    "prisma/migrations",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "chat-migrate": "bin/migrate.js"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/run.mjs && node test/e2e/run-extended.mjs && node test/e2e/run-hardening.mjs && sleep 65 && node test/e2e/run-concurrency.mjs",
    "test:e2e:golden": "node test/e2e/run.mjs",
    "test:e2e:extended": "node test/e2e/run-extended.mjs",
    "test:e2e:hardening": "node test/e2e/run-hardening.mjs",
    "test:e2e:concurrency": "node test/e2e/run-concurrency.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "dependencies": {
    "@nestjs/config": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.4",
    "ioredis": "^5.4.2",
    "nest-winston": "^1.10.2",
    "pg": "^8.20.0",
    "prisma": "^7.10.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "socket.io-client": "^4.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
